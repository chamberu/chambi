{
    "name": "chamvi-root",
    "private": true,
    "version": "0.3.1",
    "type": "module",
    "description": "Self-hosted, trigger-driven AI agents with durable runs, built on the Vercel AI SDK.",
    "author": {
        "name": "Peter Placzek",
        "email": "contact@tada5hi.net",
        "url": "https://github.com/tada5hi"
    },
    "homepage": "https://chamvi.dev",
    "repository": {
        "type": "git",
        "url": "https://github.com/chamvi/chamvi.git"
    },
    "workspaces": [
        "packages/*"
    ],
    "engines": {
        "node": ">=22.0.0"
    },
    "scripts": {
        "build": "npx nx run-many -t build",
        "test": "npx nx run-many -t test",
        "test:coverage": "npx nx run-many -t test:coverage",
        "typecheck": "npx nx run-many -t typecheck",
        "lint": "eslint",
        "lint:fix": "npm run lint -- --fix",
        "docs:dev": "npm run dev -w @chamvi/docs",
        "docs:build": "npm run build -w @chamvi/docs",
        "prepare": "husky"
    },
    "license": "Apache-2.0",
    "devDependencies": {
        "@tada5hi/commitlint-config": "^1.3.1",
        "@tada5hi/eslint-config": "^2.3.1",
        "@tada5hi/tsconfig": "^0.7.2",
        "@types/node": "^26.6.5",
        "@vitest/coverage-v8": "^5.0.4",
        "eslint": "^10.8.0",
        "eslint-plugin-vue": "^10.11.1",
        "husky": "^9.1.7",
        "nx": "^24.0.1",
        "ts-node": "^10.9.2",
        "tsdown": "^0.23.1",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.0",
        "vitest": "^5.0.4"
    }
}
