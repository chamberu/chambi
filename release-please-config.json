{
    "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
    "include-component-in-tag": false,
    "release-as": "0.3.1",
    "release-type": "node",
    "bump-minor-pre-major": true,
    "bump-patch-for-minor-pre-major": true,
    "initial-version": "0.1.0",
    "packages": {
        ".": {"component": "root"},
        "packages/app": {"component": "app"},
        "packages/channel-cron": {"component": "channel-cron"},
        "packages/channel-openclaw": {"component": "channel-openclaw"},
        "packages/cli": {"component": "cli"},
        "packages/coding": {"component": "coding"},
        "packages/core": {"component": "core"},
        "packages/github": {"component": "github"},
        "packages/http": {"component": "http"},
        "packages/sandbox": {"component": "sandbox"},
        "packages/sandbox-docker": {"component": "sandbox-docker"},
        "packages/sandbox-k8s": {"component": "sandbox-k8s"},
        "packages/sandbox-local": {"component": "sandbox-local"},
        "packages/store-typeorm": {"component": "store-typeorm"},
        "packages/test-kit": {"component": "test-kit"},
        "packages/tool-web": {"component": "tool-web"},
        "packages/ui": {"component": "ui"}
    },
    "plugins": [
        {
            "type": "node-workspace",
            "updateAllPackages": true,
            "updatePeerDependencies": true
        },
        {
            "type": "linked-versions",
            "groupName": "main",
            "components": [
                "root",
                "app",
                "channel-cron",
                "channel-openclaw",
                "cli",
                "coding",
                "core",
                "github",
                "http",
                "sandbox",
                "sandbox-docker",
                "sandbox-k8s",
                "sandbox-local",
                "store-typeorm",
                "test-kit",
                "tool-web",
                "ui"
            ]
        }
    ]
}
