{
    "name": "@chamvi/core",
    "version": "0.4.0",
    "type": "module",
    "description": "Core engine for self-hosted, trigger-driven AI agents: agents, triggers and durable runs.",
    "author": {
        "name": "Peter Placzek",
        "email": "contact@tada5hi.net",
        "url": "https://github.com/tada5hi"
    },
    "homepage": "https://chamvi.dev",
    "repository": {
        "type": "git",
        "url": "https://github.com/chamvi/chamvi.git",
        "directory": "packages/core"
    },
    "main": "dist/index.mjs",
    "types": "dist/index.d.mts",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "types": "./dist/index.d.mts",
            "import": "./dist/index.mjs"
        },
        "./conversation/persistence": {
            "types": "./dist/conversation/persistence.d.mts",
            "import": "./dist/conversation/persistence.mjs"
        }
    },
    "files": [
        "dist",
        "NOTICE"
    ],
    "engines": {
        "node": ">=24.3.0"
    },
    "scripts": {
        "build:types": "tsc --noEmit -p tsconfig.build.json",
        "build:js": "tsdown",
        "build": "npm run build:types && npm run build:js",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "test": "vitest --config test/vitest.config.ts --run",
        "test:coverage": "vitest --config test/vitest.config.ts --run --coverage"
    },
    "keywords": [
        "ai",
        "agent",
        "trigger",
        "durable"
    ],
    "publishConfig": {
        "access": "public"
    },
    "license": "Apache-2.0",
    "dependencies": {
        "@ebec/core": "^1.3.2",
        "@standard-schema/spec": "^1.1.0",
        "@validup/standard-schema": "^2.0.1",
        "smob": "^1.6.2",
        "validup": "^2.0.1"
    },
    "devDependencies": {
        "ai": "^7.0.150",
        "zod": "^4.6.7"
    },
    "peerDependencies": {
        "ai": "^7"
    }
}
