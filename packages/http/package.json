{
    "name": "@chamvi/http",
    "version": "0.2.1",
    "type": "module",
    "description": "REST, SSE, webhooks and MCP for chamvi agents, on routup.",
    "author": {
        "name": "Peter Placzek",
        "email": "contact@tada5hi.net",
        "url": "https://github.com/tada5hi"
    },
    "homepage": "https://chamvi.dev",
    "repository": {
        "type": "git",
        "url": "https://github.com/chamvi/chamvi.git",
        "directory": "packages/http"
    },
    "main": "dist/index.mjs",
    "types": "dist/index.d.mts",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "types": "./dist/index.d.mts",
            "import": "./dist/index.mjs"
        }
    },
    "files": [
        "dist",
        "NOTICE"
    ],
    "engines": {
        "node": ">=22.0.0"
    },
    "scripts": {
        "build:types": "tsc --noEmit -p tsconfig.build.json",
        "build:js": "tsdown",
        "build": "npm run build:types && npm run build:js",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "test": "vitest --config test/vitest.config.ts --run",
        "test:coverage": "vitest --config test/vitest.config.ts --run --coverage"
    },
    "keywords": [
        "chamvi",
        "http",
        "rest",
        "sse",
        "mcp",
        "webhook",
        "routup"
    ],
    "publishConfig": {
        "access": "public"
    },
    "license": "Apache-2.0",
    "dependencies": {
        "@authup/server-adapter-kit": "^1.0.0-beta.70",
        "@authup/server-adapter-web": "^1.0.0-beta.70",
        "@ebec/core": "^1.3.2",
        "@ebec/http": "^4.3.2",
        "@modelcontextprotocol/server": "^2.4.0",
        "@rapiq/codec-url": "^2.4.0",
        "@rapiq/core": "^2.4.0",
        "@rapiq/parser-expression": "^2.4.0",
        "@rapiq/parser-simple": "^2.4.0",
        "@routup/cors": "^2.0.0",
        "@routup/prometheus": "^4.0.0",
        "@routup/rate-limit": "^4.0.1",
        "@standard-schema/spec": "^1.1.0",
        "@validup/standard-schema": "^2.0.1",
        "cron-parser": "^5.10.2",
        "prom-client": "^15.1.3",
        "routup": "^6.1.0",
        "smob": "^1.6.2",
        "validup": "^2.0.1",
        "vouchly": "^0.1.1"
    },
    "devDependencies": {
        "@chamvi/core": "^0.2.1",
        "@chamvi/test-kit": "^0.2.1",
        "@modelcontextprotocol/client": "^2.3.1",
        "ai": "^7.0.150",
        "jose": "^6.2.13",
        "zod": "^4.6.7"
    },
    "peerDependencies": {
        "@chamvi/core": "^0.2.1"
    }
}
