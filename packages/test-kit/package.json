{
    "name": "@chamvi/test-kit",
    "version": "0.2.1",
    "type": "module",
    "description": "Test helpers for chamvi: a controllable clock, the store and workspace contract suites, a git fixture and a fake GitHub.",
    "author": {
        "name": "Peter Placzek",
        "email": "contact@tada5hi.net",
        "url": "https://github.com/tada5hi"
    },
    "homepage": "https://chamvi.dev",
    "repository": {
        "type": "git",
        "url": "https://github.com/chamvi/chamvi.git",
        "directory": "packages/test-kit"
    },
    "main": "dist/index.mjs",
    "types": "dist/index.d.mts",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "types": "./dist/index.d.mts",
            "import": "./dist/index.mjs"
        }
    },
    "files": [
        "dist",
        "NOTICE"
    ],
    "engines": {
        "node": ">=22.0.0"
    },
    "scripts": {
        "build:types": "tsc --noEmit -p tsconfig.build.json",
        "build:js": "tsdown",
        "build": "npm run build:types && npm run build:js",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "test": "vitest --config test/vitest.config.ts --run",
        "test:coverage": "vitest --config test/vitest.config.ts --run --coverage"
    },
    "keywords": [
        "chamvi",
        "testing",
        "store",
        "contract",
        "github",
        "fake"
    ],
    "publishConfig": {
        "access": "public"
    },
    "license": "Apache-2.0",
    "devDependencies": {
        "@chamvi/core": "^0.2.1"
    },
    "peerDependencies": {
        "@chamvi/core": "^0.2.1",
        "vitest": "^5"
    }
}
