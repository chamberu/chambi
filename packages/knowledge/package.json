{
    "name": "@chamvi/knowledge",
    "version": "0.4.0",
    "type": "module",
    "description": "Knowledge collections for chamvi agents: reference material searched by meaning through a tool, never put into the model context.",
    "author": {
        "name": "Peter Placzek",
        "email": "contact@tada5hi.net",
        "url": "https://github.com/tada5hi"
    },
    "homepage": "https://chamvi.dev",
    "repository": {
        "type": "git",
        "url": "https://github.com/chamvi/chamvi.git",
        "directory": "packages/knowledge"
    },
    "main": "dist/index.mjs",
    "types": "dist/index.d.mts",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "types": "./dist/index.d.mts",
            "import": "./dist/index.mjs"
        },
        "./module": {
            "types": "./dist/module.d.mts",
            "import": "./dist/module.mjs"
        }
    },
    "files": [
        "dist",
        "NOTICE"
    ],
    "engines": {
        "node": ">=24.3.0"
    },
    "scripts": {
        "build:types": "tsc --noEmit -p tsconfig.build.json",
        "build:js": "tsdown",
        "build": "npm run build:types && npm run build:js",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "test": "vitest --config test/vitest.config.ts --run",
        "test:coverage": "vitest --config test/vitest.config.ts --run --coverage"
    },
    "keywords": [
        "chamvi",
        "knowledge",
        "rag",
        "embeddings",
        "search",
        "agent"
    ],
    "publishConfig": {
        "access": "public"
    },
    "license": "Apache-2.0",
    "dependencies": {
        "smob": "^1.6.2"
    },
    "devDependencies": {
        "@chamvi/app": "^0.4.0",
        "@chamvi/core": "^0.4.0",
        "@chamvi/test-kit": "^0.4.0",
        "ai": "^7.0.150"
    },
    "peerDependencies": {
        "@chamvi/app": "^0.4.0",
        "@chamvi/core": "^0.4.0",
        "ai": "^7"
    },
    "peerDependenciesMeta": {
        "@chamvi/app": {
            "optional": true
        }
    }
}
