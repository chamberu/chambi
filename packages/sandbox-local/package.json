{
    "name": "@chamvi/sandbox-local",
    "version": "0.3.1",
    "type": "module",
    "description": "Local sandbox provider for chamvi: workspaces in a temporary directory, no isolation.",
    "author": {
        "name": "Peter Placzek",
        "email": "contact@tada5hi.net",
        "url": "https://github.com/tada5hi"
    },
    "homepage": "https://chamvi.dev",
    "repository": {
        "type": "git",
        "url": "https://github.com/chamvi/chamvi.git",
        "directory": "packages/sandbox-local"
    },
    "main": "dist/index.mjs",
    "types": "dist/index.d.mts",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "types": "./dist/index.d.mts",
            "import": "./dist/index.mjs"
        }
    },
    "files": [
        "dist",
        "NOTICE"
    ],
    "engines": {
        "node": ">=22.0.0"
    },
    "scripts": {
        "build:types": "tsc --noEmit -p tsconfig.build.json",
        "build:js": "tsdown",
        "build": "npm run build:types && npm run build:js",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "test": "vitest --config test/vitest.config.ts --run",
        "test:coverage": "vitest --config test/vitest.config.ts --run --coverage"
    },
    "keywords": [
        "chamvi",
        "sandbox",
        "workspace",
        "local"
    ],
    "publishConfig": {
        "access": "public"
    },
    "license": "Apache-2.0",
    "dependencies": {
        "smob": "^1.6.2"
    },
    "devDependencies": {
        "@chamvi/core": "^0.3.1",
        "@chamvi/sandbox": "^0.3.1",
        "@chamvi/test-kit": "^0.3.1"
    },
    "peerDependencies": {
        "@chamvi/core": "^0.3.1",
        "@chamvi/sandbox": "^0.3.1"
    }
}
