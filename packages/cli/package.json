{
    "name": "@chamvi/cli",
    "version": "0.4.1",
    "type": "module",
    "description": "The chamvi command line: dev, build, start, run-job and migrate for an app built with @chamvi/app.",
    "author": {
        "name": "Peter Placzek",
        "email": "contact@tada5hi.net",
        "url": "https://github.com/tada5hi"
    },
    "homepage": "https://chamvi.dev",
    "repository": {
        "type": "git",
        "url": "https://github.com/chamvi/chamvi.git",
        "directory": "packages/cli"
    },
    "main": "dist/index.mjs",
    "types": "dist/index.d.mts",
    "bin": {
        "chamvi": "./dist/cli.mjs"
    },
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "types": "./dist/index.d.mts",
            "import": "./dist/index.mjs"
        }
    },
    "files": [
        "dist",
        "NOTICE"
    ],
    "engines": {
        "node": ">=24.3.0"
    },
    "scripts": {
        "build:types": "tsc --noEmit -p tsconfig.build.json",
        "build:js": "tsdown",
        "build": "npm run build:types && npm run build:js",
        "dev": "node --loader ts-node/esm src/cli.ts",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "test": "vitest --config test/vitest.config.ts --run",
        "test:coverage": "vitest --config test/vitest.config.ts --run --coverage"
    },
    "nx": {
        "targets": {
            "test": {
                "dependsOn": [
                    "build"
                ]
            }
        }
    },
    "keywords": [
        "chamvi",
        "cli",
        "agents"
    ],
    "publishConfig": {
        "access": "public"
    },
    "license": "Apache-2.0",
    "dependencies": {
        "citty": "^0.2.2"
    },
    "devDependencies": {
        "@chamvi/app": "^0.4.1",
        "@chamvi/github": "^0.4.1",
        "@chamvi/test-kit": "^0.4.1",
        "@swc/core": "^1.16.20",
        "ai": "^7.0.150",
        "tsdown": "^0.23.1",
        "unplugin-swc": "^2.0.0"
    },
    "peerDependencies": {
        "@chamvi/app": "^0.4.1",
        "tsdown": "^0.23.1"
    },
    "peerDependenciesMeta": {
        "tsdown": {
            "optional": true
        }
    }
}
