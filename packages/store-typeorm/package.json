{
    "name": "@chamvi/store-typeorm",
    "version": "0.3.0",
    "type": "module",
    "description": "TypeORM store for chamvi (PostgreSQL): durable runs, leases and agent state.",
    "author": {
        "name": "Peter Placzek",
        "email": "contact@tada5hi.net",
        "url": "https://github.com/tada5hi"
    },
    "homepage": "https://chamvi.dev",
    "repository": {
        "type": "git",
        "url": "https://github.com/chamvi/chamvi.git",
        "directory": "packages/store-typeorm"
    },
    "main": "dist/index.mjs",
    "types": "dist/index.d.mts",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "types": "./dist/index.d.mts",
            "import": "./dist/index.mjs"
        }
    },
    "files": [
        "dist",
        "NOTICE"
    ],
    "engines": {
        "node": ">=22.0.0"
    },
    "scripts": {
        "build:types": "tsc --noEmit -p tsconfig.build.json",
        "build:js": "tsdown",
        "build": "npm run build:types && npm run build:js",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "test": "vitest --config test/vitest.config.ts --run",
        "test:coverage": "vitest --config test/vitest.config.ts --run --coverage"
    },
    "keywords": [
        "chamvi",
        "store",
        "postgres",
        "typeorm"
    ],
    "publishConfig": {
        "access": "public"
    },
    "license": "Apache-2.0",
    "dependencies": {
        "typeorm-extension": "^4.3.0"
    },
    "devDependencies": {
        "@chamvi/core": "^0.3.0",
        "@chamvi/test-kit": "^0.3.0",
        "@swc/core": "^1.16.20",
        "@testcontainers/postgresql": "^12.2.1",
        "ai": "^7.0.150",
        "pg": "^8.23.1",
        "typeorm": "^1.1.2",
        "unplugin-swc": "^2.0.0",
        "zod": "^4.6.7"
    },
    "peerDependencies": {
        "@chamvi/core": "^0.3.0",
        "pg": "^8",
        "typeorm": "^1.1.2"
    }
}
